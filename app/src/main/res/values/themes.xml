<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the app's paper colour so launch has no white flash. -->
    <style name="Theme.Budget" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
    </style>
    <color name="paper">#F4F5F1</color>
</resources>
